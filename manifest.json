{
  "manifest_version": 2,
  "name": "Firefox Theme Manager",
  "version": "0.0.1",
  "description": "Manage and switch Firefox themes easily",

  "icons": {
    "48": "icons/icon-redux.png"
  },

  "permissions": ["storage", "management", "theme"],

  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon-redux.png"
  },

  "background": {
    "scripts": ["src/background/mongoose.js"]
  }
}
