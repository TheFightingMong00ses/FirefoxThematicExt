{
  "manifest_version": 3,
  "name": "Firefox Theme Manager",
  "version": "0.0.1",
  "description": "Manage and switch Firefox themes easily",

  "browser_specific_settings": {
    "gecko": {
      "id": "theme-manager@yourdomain.com",
      "strict_min_version": "109.0"
    }
  },

  "data_collection_permissions": {
    "collected": false
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": ["storage", "management", "theme"],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon-48.png"
  },

  "background": {
    "scripts": ["src/background/group_class.js", "src/background/mongoose.js"]
  }
}
