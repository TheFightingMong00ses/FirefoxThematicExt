{
  "manifest_version": 2,
  "name": "Firefox Theme Manager",
  "version": "0.0.1",
  "description": "Manage and switch Firefox themes easily",

  "icons": {
    "48": "icons/border-48.png"
  },

  "permissions": ["storage", "management", "theme"],

  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/border-48.png"
  },

  "background": {
    "scripts": [
    "src/background/group_class.js",
    "src/background/mongoose.js",
    "src/popup/popup.js"
  ],
  "type": "module"
  },
  "content_scripts":[
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/background/group_class.js",
        "src/background/mongoose.js",
        "src/popup/popup.js"
      ]
    }
  ]
}
